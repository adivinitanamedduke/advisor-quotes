# Copy to .env (gitignored) or set these in your shell. ASP.NET Core maps "__" to ":" in config keys.

# PostgreSQL connection (default matches docker-compose.yml)
ConnectionStrings__Quotes=Host=localhost;Port=5432;Database=advisor_quotes;Username=postgres;Password=postgres

# Apply EF migrations on startup (true in Development by default)
Database__MigrateOnStartup=true

# Duplicate submission window for requests without an Idempotency-Key
Idempotency__WindowMinutes=10

# Pricing overrides, e.g. the smoker loading
# Pricing__SmokerLoading=1.5

ASPNETCORE_ENVIRONMENT=Development

# Log format: json (default, one compact JSON object per line) or text (readable, still shows TraceId)
# Observability__LogFormat=text

# Print metrics to the console every minute when no OTLP endpoint is set (off by default: noisy)
# Observability__ConsoleMetrics=true

# Optional: send traces to an OTLP collector (e.g. Jaeger) instead of the console only
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Integration tests: use an existing PostgreSQL instead of Testcontainers
# TEST_POSTGRES_CONNECTION=Host=localhost;Port=5432;Database=advisor_quotes_tests;Username=postgres;Password=postgres
